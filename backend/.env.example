# Copy this file to .env and fill in real values. Never commit .env.

# Google Gemini API key (fallback LLM for explanation generation)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local Llama endpoint (e.g. Ollama running on this machine)
LLAMA_ENDPOINT=http://localhost:11434/api/generate
LLAMA_MODEL=qwen2.5-coder:7b

# Hugging Face model cache directory (sentence-transformers weights)
HF_HOME=./hf_cache
