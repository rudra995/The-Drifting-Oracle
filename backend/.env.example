# Copy this file to .env and fill in real values. Never commit .env.

# Google Gemini API key (fallback LLM for explanation generation)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local Llama endpoint (e.g. Ollama running on this machine)
LLAMA_ENDPOINT=http://localhost:11434/api/generate
LLAMA_MODEL=qwen2.5-coder:7b

# Hugging Face model cache directory (sentence-transformers weights)
HF_HOME=./hf_cache

# Databricks workspace — Settings -> Developer -> Access tokens for DATABRICKS_TOKEN
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=drifting_oracle
DATABRICKS_SCHEMA=monitoring
# SQL warehouse HTTP path, e.g. /sql/1.0/warehouses/<warehouse_id>
DATABRICKS_HTTP_PATH=

# MLflow tracking/registry — point at the Databricks workspace instead of a local file store
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
